[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-fintube
Name=FinTube
Exec=harbour-fintube %U
MimeType=x-url-handler/youtube.com;x-url-handler/www.youtube.com;x-url-handler/m.youtube.com;x-url-handler/youtu.be
X-Maemo-Service=harbour.fintube
X-Maemo-Object-Path=/
X-Maemo-Method=harbour.fintube.openUrl

# Sandboxing is disabled deliberately. A YouTube client needs an in-process loopback HTTP
# proxy (GStreamer <-> Python, on 127.0.0.1) for header injection + range handling, plus an
# external yt-dlp subprocess; Sailjail's network confinement refuses the loopback connection
# ("Connection Refused" on playback). MicroTube ships the same way for the same reason. This
# is fine for our channel — FinTube is distributed via Chum/OpenRepos, not Jolla Harbour
# (Harbour is the only store that requires sandboxing).
[X-Sailjail]
Sandboxing=Disabled
